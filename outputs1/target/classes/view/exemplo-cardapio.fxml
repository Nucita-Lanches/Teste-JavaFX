<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<BorderPane fx:id="appRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.nucitalanches.preview.MenuController" stylesheets="@../css/javafx-nucita-theme.css">
  <left>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="205" minWidth="205" styleClass="sidebar-scroll">
    <content>
    <VBox styleClass="sidebar" prefWidth="205" minWidth="205" spacing="10">
      <StackPane fx:id="sidebarLogoSlot" styleClass="sidebar-logo"/>
      <Label text="FEITO PARA DAR VONTADE." styleClass="brand-caption"/>
      <Separator/>
      <Label text="EXPLORE" styleClass="side-caption"/>
      <Button fx:id="menuNav" text="▦   Cardápio" styleClass="nav-button,nav-active" maxWidth="Infinity" onAction="#showMenu"/>
      <Button fx:id="productNav" text="＋   Cadastrar produto" styleClass="nav-button" maxWidth="Infinity" onAction="#showProductRegistration"/>
      <Button fx:id="registerNav" text="＋   Cadastrar usuário" styleClass="nav-button" maxWidth="Infinity" onAction="#showUserRegistration"/>
      <Button fx:id="usersNav" text="⌕   Consultar usuários" styleClass="nav-button" maxWidth="Infinity" onAction="#showUserConsultation"/>
      <Button text="▣   Mesas" styleClass="nav-button" maxWidth="Infinity" onAction="#showTables"/>
      <Button text="◷   Meus pedidos" styleClass="nav-button" maxWidth="Infinity" onAction="#showOrders"/>
      <Region VBox.vgrow="ALWAYS"/>
      <VBox styleClass="side-note" spacing="8"><Label text="O seu doce favorito." styleClass="note-title"/><Label text="Um pouco de chocolate. Muito de Nucita." styleClass="note-copy" wrapText="true"/></VBox>
      <HBox alignment="CENTER_LEFT" spacing="9" styleClass="profile"><Label text="N" styleClass="avatar"/><VBox spacing="3"><Label fx:id="profileName" text="Nucita Lanches" maxWidth="120" styleClass="profile-name"/><Label text="Conectado" styleClass="note-copy"/></VBox></HBox>
      <Button text="Sair do sistema" styleClass="nav-button" maxWidth="Infinity" onAction="#logout"/>
    </VBox>
    </content>
    </ScrollPane>
  </left>
  <center>
    <BorderPane fx:id="pageContainer" styleClass="main-area">
      <top><HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar"><VBox spacing="5"><Label fx:id="pageEyebrow" text="BEM-VINDO À NUCITA" styleClass="eyebrow"/><Label fx:id="pageTitle" text="Hoje pede algo especial." styleClass="page-title"/></VBox><Region HBox.hgrow="ALWAYS"/><ToggleButton fx:id="motionToggle" text="Animações" accessibleText="Ativar ou desativar animações" onAction="#toggleMotion" styleClass="appearance-toggle"/><ToggleButton fx:id="themeToggle" text="Tema escuro" accessibleText="Alternar tema claro e escuro" onAction="#toggleTheme" styleClass="appearance-toggle"/></HBox></top>
      <center><ScrollPane fx:id="menuView" fitToWidth="true" hbarPolicy="NEVER" styleClass="menu-scroll"><VBox spacing="23" styleClass="menu-content">
        <HBox styleClass="hero" minHeight="222" alignment="CENTER_LEFT">
          <VBox spacing="13" HBox.hgrow="ALWAYS"><Label text="AQUELE SABOR QUE ABRAÇA" styleClass="hero-eyebrow"/><Label text="Seu momento." styleClass="hero-title"/><Label text="Seu Nucita." styleClass="hero-title"/><Label text="Chocolate, avelã e uma pausa deliciosa no seu dia." styleClass="hero-copy" wrapText="true"/><Button text="Descobrir os favoritos   →" styleClass="hero-button" onAction="#showFavorites"/></VBox>
          <StackPane fx:id="heroLogoSlot" styleClass="hero-logo"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="14"><VBox spacing="5"><Label text="Escolha seu próximo favorito" styleClass="section-title"/><Label text="Feito com carinho, servido do seu jeito." styleClass="muted-label"/></VBox><Region HBox.hgrow="ALWAYS"/><Label text="DA CASA" styleClass="tiny-caption"/></HBox>
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="10"><Label text="⌕" styleClass="search-icon"/><TextField fx:id="searchField" promptText="O que você está com vontade de comer?" HBox.hgrow="ALWAYS" styleClass="search-field"/><Label text="BUSCAR" styleClass="tiny-caption"/></HBox>
        <HBox spacing="9"><ToggleButton fx:id="allCategory" text="Todos" onAction="#filterAll" styleClass="category-chip"/><ToggleButton fx:id="sweetsCategory" text="Doces da casa" onAction="#filterSweets" styleClass="category-chip"/><ToggleButton fx:id="drinksCategory" text="Bebidas" onAction="#filterDrinks" styleClass="category-chip"/><ToggleButton fx:id="snacksCategory" text="Lanches" onAction="#filterSnacks" styleClass="category-chip"/></HBox>
        <TilePane fx:id="productGrid" hgap="16" vgap="18" prefColumns="3" tileAlignment="TOP_LEFT"/>
        <Label fx:id="emptyLabel" text="Nenhum produto encontrado. Tente outra busca." styleClass="muted-label" visible="false" managed="false"/>
        <HBox alignment="CENTER_LEFT" styleClass="bottom-note"><Label text="NUCITA LANCHES" styleClass="tiny-caption"/><Region HBox.hgrow="ALWAYS"/><Label text="Sabores que viram bons momentos." styleClass="muted-label"/></HBox>
      </VBox></ScrollPane></center>
    </BorderPane>
  </center>
  <right><VBox fx:id="orderPanel" styleClass="order-panel" prefWidth="285" minWidth="285" spacing="18">
    <HBox alignment="CENTER_LEFT"><Label text="Seu pedido" styleClass="order-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="countLabel" text="0" styleClass="count-bubble"/></HBox>
    <HBox styleClass="table-box" alignment="CENTER_LEFT"><VBox spacing="5"><Label text="ATENDIMENTO NA MESA" styleClass="tiny-caption"/><Label fx:id="tableLabel" text="Mesa 04" styleClass="table-name"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Trocar" onAction="#showTables" styleClass="text-button"/></HBox>
    <Label text="SEUS FAVORITOS ESTÃO AQUI" styleClass="tiny-caption"/>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="cart-scroll"><VBox fx:id="cartItems" spacing="14"/></ScrollPane>
    <Label fx:id="statusLabel" text="Adicione algo gostoso ao seu pedido." wrapText="true" styleClass="status-message"/>
    <Separator/>
    <HBox><Label text="Subtotal" styleClass="muted-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="subtotalLabel" text="R$ 0,00" styleClass="subtotal"/></HBox>
    <HBox alignment="CENTER_LEFT"><Label text="Total do pedido" styleClass="total-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="totalLabel" text="R$ 0,00" styleClass="total-price"/></HBox>
    <Button fx:id="checkoutButton" text="Confirmar pedido   →" styleClass="checkout-button" maxWidth="Infinity" onAction="#checkout"/>
    <Label text="PRÉVIA • PEDIDOS DE DEMONSTRAÇÃO" styleClass="fine-print" wrapText="true"/>
  </VBox></right>
</BorderPane>
